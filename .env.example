# Database and CSV configuration
DATABASE_PATH=data/sales.db
CSV_PATH=data/sales_data.csv

# Backend API configuration
API_HOST=127.0.0.1
API_PORT=8000

# LLM Configuration
# Optional: If no API key is provided, the system seamlessly uses the documented deterministic fallback interpreter.
# Supported providers: gemini, openai, fallback
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
